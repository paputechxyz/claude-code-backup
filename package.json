{
  "name": "@paputechxyz/claude-code-backup",
  "version": "0.3.1",
  "description": "Automatic backup and sync of all Claude Code settings to GitHub",
  "type": "module",
  "bin": {
    "ccb": "./bin/cli.mjs",
    "claude-code-backup": "./bin/cli.mjs"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "keywords": [
    "claude-code",
    "backup",
    "sync",
    "dotfiles",
    "settings",
    "skills",
    "memories"
  ],
  "author": "paputechxyz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paputechxyz/claude-code-backup"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "esbuild bin/cli.mjs --bundle --platform=node --format=esm --target=node18 --outfile=dist/ccb.mjs",
    "clean": "rm -rf dist",
    "notify:test": "node bin/cli.mjs notify-test"
  }
}
